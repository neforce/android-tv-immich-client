<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Screensaver van het systeem op deze app zetten (Settings.Secure.screensaver_components). Een gewone app krijgt
         deze permissie niet vanzelf: eenmalig via adb `pm grant` (zie ScreensaverInstellen.kt); zonder blijft de app
         gewoon werken en toont hij de uitleg. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- MapLibre kijkt of er netwerk is (ConnectivityReceiver) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_fotos"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Photos"
        android:usesCleartextTraffic="true">

        <!-- De activity zelf staat niet in de launcher: dat doen de aliassen hieronder (naam + icoon + banner per
             "uiterlijk", zie Instellingen.kt/Uiterlijk). Precies één alias staat aan; standaard "Photos". Labels en
             banners zijn vertaald (values-xx, drawable-xx-nodpi) en volgen de systeemtaal van de launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity-alias android:name=".Fotos" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
            android:label="@string/alias_fotos" android:icon="@mipmap/ic_fotos" android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Fotoalbum" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:label="@string/alias_album" android:icon="@mipmap/ic_album" android:banner="@drawable/banner_album">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Herinneringen" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:label="@string/alias_herinneringen" android:icon="@mipmap/ic_herinneringen" android:banner="@drawable/banner_herinneringen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Familie" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:label="@string/alias_familie" android:icon="@mipmap/ic_familie" android:banner="@drawable/banner_familie">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Screensaver (DreamService, zie Dream.kt). Het label is wat de systeeminstellingen tonen waar een keuzelijst
             bestaat; dream.xml koppelt het tandwieltje aan de instellingen van de app. -->
        <service
            android:name=".FotoDream"
            android:exported="true"
            android:label="@string/dream_naam"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <!-- Voorbeeld van de screensaver (Instellingen → Screensaver → Voorbeeld). Exported met de DUMP-permissie: alleen de app
             zelf en de shell (`am start -n com.immichclient.tv/.VoorbeeldActivity`, om te testen) kunnen hem starten. -->
        <activity
            android:name=".VoorbeeldActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <!-- Instellingen van de screensaver (settingsActivity in dream.xml): opent de app in Instellingen → Screensaver -->
        <activity-alias
            android:name=".ScreensaverInstellingen"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/dream_naam" />

        <!-- Sleutel + server zetten via adb zonder de app te openen (zie SleutelOntvanger). DUMP heeft alleen de shell/het
             systeem, geen gewone app. -->
        <receiver
            android:name=".SleutelOntvanger"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.immichclient.tv.SET_KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
